# Required: TypeSafe API key (https://console.typesafe.ai/)
TYPESAFE_API_KEY=

# shadow = evaluate and log, never block (default, use this for the first week)
# enforce = decisions are applied
JEV_GUARD_MODE=shadow

# Jev endpoint / model
JEV_GUARD_API_BASE=https://api.typesafe.ai/v1/systemone
JEV_GUARD_MODEL=jev-latest

# Budget: a hook runs on every tool call, so keep this tight
JEV_GUARD_TIMEOUT_MS=1500
JEV_GUARD_CACHE_TTL_MS=60000

# If Jev is unreachable: 1 = fall back to the deterministic floor only (recommended)
#                        0 = block the action
JEV_GUARD_FAIL_OPEN=1

# Threshold overrides (0..1). Format: JEV_GUARD_THRESH_<SIGNAL>_<BLOCK|ASK|WARN>
# JEV_GUARD_THRESH_DESTRUCTIVE_BLOCK=0.85
# JEV_GUARD_THRESH_SECRET_EXPOSURE_BLOCK=0.70
# JEV_GUARD_THRESH_SCOPE_CREEP_ASK=0.80

# Write the full redacted action to the session log, for the training pipeline
# in training/. Off by default: it keeps more of your session on disk.
# JEV_GUARD_COLLECT=1

# Ask a second endpoint in parallel and log what it would have decided. The
# primary still decides. This is how a challenger model is compared against the
# incumbent on identical traffic.
# JEV_GUARD_COMPARE_API_BASE=http://127.0.0.1:8787/v1/systemone
# JEV_GUARD_COMPARE_MODEL=jevlab-local

# --- Which model decides -----------------------------------------------------
# jev (default) | anthropic | openai | deepseek | kimi | grok | mistral | groq |
# together | openrouter | google | ollama | lmstudio | vllm | jevlab
# JEV_GUARD_PROVIDER=jev
#
# Required for every provider except anthropic and jev — set the model id from
# your provider's own list rather than trusting a default that may be retired.
# JEV_GUARD_MODEL=
#
# Provider keys are read from their usual env vars:
#   ANTHROPIC_API_KEY  OPENAI_API_KEY  DEEPSEEK_API_KEY  MOONSHOT_API_KEY
#   XAI_API_KEY  MISTRAL_API_KEY  GROQ_API_KEY  TOGETHER_API_KEY
#   OPENROUTER_API_KEY  GEMINI_API_KEY
# Local runtimes (ollama, lmstudio, vllm, jevlab) need none.
#
# Score a challenger against the incumbent on identical live traffic. The
# primary still decides; only the disagreements are logged.
# JEV_GUARD_COMPARE_PROVIDER=anthropic
