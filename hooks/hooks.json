{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.mjs\"",
            "timeout": 10,
            "statusMessage": "jev-guard: recording goal"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|WebFetch|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "jev-guard: checking action"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit|WebFetch|Task|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "jev-guard: reviewing result"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.mjs\"",
            "timeout": 15,
            "statusMessage": "jev-guard: verifying completion"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/bin/claude-hook.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
