{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"__JEV_GUARD_BIN__\"", "timeout": 10 }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__JEV_GUARD_BIN__\"",
            "timeout": 15,
            "statusMessage": "jev-guard: checking action"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "command": "node \"__JEV_GUARD_BIN__\"", "timeout": 15 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"__JEV_GUARD_BIN__\"", "timeout": 15 }
        ]
      }
    ]
  }
}
